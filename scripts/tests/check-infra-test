#!/usr/bin/env bash
# Testes isolados; nenhum comando Docker, systemd ou Git real é executado.
set -euo pipefail

repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
work=$(mktemp -d "$repo_dir/scripts/tests/.check-infra-test.XXXXXXXX")
trap 'rm -rf -- "$work"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
mkdir "$work/bin"

cat > "$work/bin/mock" <<'MOCK'
#!/bin/bash
set -eu
unexpected() {
    printf '%s: comando inesperado\n' "${0##*/}" >> "$MOCK_ERRORS"
    exit 99
}
printf '%s' "${0##*/}" >> "$MOCK_CALLS"
printf ' <%s>' "$@" >> "$MOCK_CALLS"
printf '\n' >> "$MOCK_CALLS"
case "${0##*/}" in
    docker)
        if [[ $# == 2 && $1 == context && $2 == show ]]; then
            printf 'rootless\n'
        elif [[ $# == 5 && $1 == context && $2 == inspect && $3 == rootless &&
            $4 == --format && $5 == '{{.Endpoints.docker.Host}}' ]]; then
            printf 'unix:///run/user/%s/docker.sock\n' "$UID"
        elif [[ $# == 5 && $1 == --host && $2 == "unix:///run/user/$UID/docker.sock" &&
            $3 == info && $4 == --format &&
            $5 == '{{range .SecurityOptions}}{{println .}}{{end}}' ]]; then
            [[ ! ${DOCKER_HOST+x} && ! ${DOCKER_CONTEXT+x} && ! ${DOCKER_TLS+x} &&
                ! ${DOCKER_TLS_VERIFY+x} && ! ${DOCKER_CERT_PATH+x} ]] || unexpected
            [[ $SCENARIO != info_error ]] || exit 1
            printf 'name=seccomp,profile=builtin\n'
            [[ $SCENARIO == non_rootless ]] || printf 'name=rootless\n'
        else
            unexpected
        fi
        ;;
    systemctl)
        [[ $# == 4 && $2 == show &&
            $4 == --property=LoadState,UnitFileState,ActiveState ]] || unexpected
        enabled=disabled active=inactive
        case "$1/$3" in
            --system/docker.service)
                [[ $SCENARIO != systemctl_error ]] || exit 1
                [[ $SCENARIO != rootful_active ]] || active=active
                [[ $SCENARIO != rootful_enabled ]] || enabled=enabled
                ;;
            --system/docker.socket|--system/containerd.service) ;;
            --user/docker.service) enabled=enabled active=active ;;
            *) unexpected ;;
        esac
        printf 'LoadState=loaded\nUnitFileState=%s\nActiveState=%s\n' "$enabled" "$active"
        ;;
    git)
        [[ $# == 7 && $1 == --no-optional-locks && $2 == -C && $3 == "$REPO_DIR" &&
            $4 == status && $5 == --short && $6 == --untracked-files=all &&
            $7 == --ignore-submodules=none ]] || unexpected
        [[ $SCENARIO != git_error ]] || exit 1
        if [[ $SCENARIO == dirty ]]; then printf ' M README.md\n'; fi
        ;;
    *) unexpected ;;
esac
MOCK
chmod +x "$work/bin/mock"
for command in docker systemctl git; do
    ln -s mock "$work/bin/$command"
done
# Único utilitário externo usado pelo script além das dependências mockadas.
ln -s "$(command -v dirname)" "$work/bin/dirname"

cat > "$work/run" <<'RUN'
source "$REPO_DIR/scripts/check-infra"
is_unix_socket() {
    [[ $1 == "/run/user/$UID/docker.sock" ]] || {
        printf 'socket inesperado\n' >> "$MOCK_ERRORS"
        return 1
    }
    [[ $SCENARIO != missing_socket ]]
}
main
RUN

fail() {
    printf 'FAIL teste: %s\n' "$1" >&2
    [[ ! -f $work/output ]] || cat "$work/output" >&2
    exit 1
}
contains() {
    [[ $output == *"$1"* ]] || fail "saída esperada: $1"
}

# Carregar a implementação não deve executar verificações nem encerrar o shell.
source "$repo_dir/scripts/check-infra"
[[ ! -v failures ]] || fail 'source executou main'
is_unix_socket "$work/absent" && fail 'caminho ausente aceito como socket'
is_unix_socket "$work/run" && fail 'arquivo regular aceito como socket'
printf 'PASS teste: source e predicado original\n'

for scenario in healthy non_rootless rootful_active rootful_enabled dirty info_error systemctl_error missing_socket git_error; do
    : > "$work/errors"
    : > "$work/calls"
    status=0
    # PATH sem fallback: comandos não previstos jamais chegam ao host.
    # Limpa overrides externos sem ler nem imprimir seus valores.
    (
        unset DOCKER_HOST DOCKER_CONTEXT DOCKER_TLS DOCKER_TLS_VERIFY DOCKER_CERT_PATH
        export PATH="$work/bin" SCENARIO="$scenario" REPO_DIR="$repo_dir"
        export MOCK_ERRORS="$work/errors" MOCK_CALLS="$work/calls"
        /bin/bash --noprofile --norc "$work/run"
    ) > "$work/output" 2>&1 || status=$?
    output=$(< "$work/output")
    calls=$(< "$work/calls")
    [[ ! -s $work/errors ]] || fail "$scenario: mock recebeu comando inesperado"
    expected_status=1 summary='1 FAIL, 0 WARN'
    case "$scenario" in
        healthy|dirty|git_error) expected_status=0 summary='0 FAIL, 0 WARN' ;;
        missing_socket) summary='2 FAIL, 0 WARN' ;;
    esac
    case "$scenario" in dirty|git_error) summary='0 FAIL, 1 WARN' ;; esac
    [[ $status == "$expected_status" ]] || fail "$scenario: exit $status, esperado $expected_status"
    contains "Resumo: $summary"
    if (( expected_status == 0 )); then
        [[ $output != *'FAIL:'* ]] || fail "$scenario: FAIL indevido"
    fi
    case "$scenario" in
        healthy)
            contains 'PASS: Socket Unix existe:'
            contains 'PASS: Contexto Docker ativo: rootless'
            contains 'PASS: Contexto rootless aponta para o socket local esperado'
            contains 'PASS: docker info indica execução rootless'
            for unit in docker.service docker.socket containerd.service; do
                contains "PASS: systemd --system $unit: disabled/inactive"
            done
            contains 'PASS: systemd --user docker.service: active'
            contains 'PASS: Working tree Git limpo (informativo)'
            ;;
        non_rootless) contains 'FAIL: docker info não indica execução rootless' ;;
        rootful_active) contains 'FAIL: systemd --system docker.service: disabled/active' ;;
        rootful_enabled) contains 'FAIL: systemd --system docker.service: enabled/inactive' ;;
        dirty) contains 'WARN: Working tree Git possui alterações (informativo):' ;;
        info_error) contains 'FAIL: Não foi possível consultar docker info pelo socket local' ;;
        systemctl_error) contains 'FAIL: Não foi possível consultar systemd --system docker.service' ;;
        missing_socket)
            contains 'FAIL: Socket Unix ausente ou caminho não é um socket:'
            contains 'FAIL: docker info não consultado: socket local indisponível'
            [[ $calls != *'<info>'* ]] || fail 'docker info chamado sem socket'
            ;;
        git_error) contains 'WARN: Não foi possível consultar o estado Git (informativo)' ;;
    esac
    printf 'PASS teste: %s\n' "$scenario"
done
printf '\nTodos os 10 testes passaram.\n'
